# Ignore .htaccess file
.htaccess

# Ignore uploads directory
uploads/

# Stored submissions, AI voice files and admin settings (keep the .htaccess that blocks it)
data/*
!data/.htaccess
!admin/.htaccess
!api/.htaccess

# Ignore vendor directory
vendor/

# Ignore composer files
composer.phar

# Ignore IDE files
.idea/
.vscode/
*.sublime-*
.claude

# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Development scripts and testing
logs/
reset.php
test.php
tests/*
!tests/api_test.php
!tests/.htaccess
phpunit.xml
development.md
config.php
